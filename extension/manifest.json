{
  "manifest_version": 3,
  "name": "Posture Check",
  "version": "1.0.0",
  "description": "Better posture through gentle reminders and guided stretches for desk workers",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/sounds/*.mp3", "assets/images/stretches/*.jpg"],
      "matches": ["<all_urls>"]
    }
  ]
}
